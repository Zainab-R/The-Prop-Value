generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Holds an unverified registration attempt until the user confirms
// the OTP emailed to them. No User row is created until then, so an
// abandoned/never-verified signup never leaves a dangling account.
model PendingRegistration {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  otpHash      String
  otpExpiresAt DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  password      String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  notifyEmail     Boolean  @default(true)
  notifyEstimate  Boolean  @default(true)
  notifyMarket    Boolean  @default(false)
  accounts      Account[]
  estimates     Estimate[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Estimate {
  id                 String   @id @default(cuid())
  userId             String
  sector             String
  propertyType       String
  propertySize       String
  villaType          String?
  constructionStatus String?
  bedrooms           Int?
  bathrooms          Int?
  furnished          Boolean?
  luxuryLevel        String?
  amenities          Json?
  roadType           String?
  estimatedMin       Decimal  @db.Decimal(12, 2)
  estimatedMax       Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  cornerPlot         Boolean  @default(false)
  mainBoulevard      Boolean  @default(false)
  parkFacing         Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  isSaved            Boolean  @default(false)
  // Snapshot of exactly which factors were applied and by how much,
  // captured at creation time — so the result page and reports stay
  // accurate even if an admin later changes a rate/multiplier.
  breakdown          Json?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model MarketRate {
  id           String   @id @default(cuid())
  propertyType String
  sector       String
  propertySize String
  basePrice    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  villaType    String?

  @@index([propertyType, propertySize, sector])
  @@index([propertyType])
  @@index([sector])
  @@index([sector, villaType, propertyType, propertySize])
  @@index([villaType])
}

model LuxuryRate {
  id         String @id @default(cuid())
  level      String @unique
  multiplier Float
}

model AmenityRate {
  id    String  @id @default(cuid())
  name  String  @unique
  value Decimal @db.Decimal(12, 2)
}

model RoadRate {
  id         String @id @default(cuid())
  roadType   String @unique
  multiplier Float
}

// Fixed set of plot/construction adjustment multipliers applied in
// lib/valuation.ts. Rows are seeded once (matching the multipliers
// that used to be hardcoded) and are edit-only from the admin UI —
// the set of keys is tied to the EstimateForm toggles, so creating or
// deleting keys isn't exposed, only changing their multiplier value.
model AdjustmentFactor {
  id         String   @id @default(cuid())
  key        String   @unique
  label      String
  multiplier Float
  updatedAt  DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
